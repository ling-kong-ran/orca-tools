{
  "manifestVersion": 1,
  "id": "parallel-download",
  "publisher": "local-tools",
  "name": "Parallel Downloads",
  "version": "1.0.3",
  "description": "Download remote files to this computer with parallel streams, pause/resume, retries and SHA-256 verification. Runs trusted local Node code and uses the existing Orca connection plus read-only per-download SSH keys.",
  "engines": {
    "orca": ">=1.4.229"
  },
  "pluginApi": 1,
  "main": "main.mjs",
  "capabilities": [
    {
      "kind": "notifications:show"
    }
  ],
  "contributes": {
    "keybindings": [
      {
        "command": "parallel-download.open",
        "key": "Ctrl+Alt+D",
        "when": "global"
      }
    ],
    "commands": [
      {
        "id": "parallel-download.open",
        "title": "Parallel Downloads: Open Manager",
        "context": "global"
      },
      {
        "id": "parallel-download.pause-all",
        "title": "Parallel Downloads: Pause All",
        "context": "global"
      }
    ]
  }
}
